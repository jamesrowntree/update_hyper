# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env`, paste it into chat, or share it -- it holds a credential
# (your Tableau Personal Access Token secret) that can publish/overwrite content
# on your site.

# ---- Where to publish -----------------------------------------------------

# Your Tableau Cloud pod URL. Find it in the address bar while signed in --
# e.g. if you're signed in at https://10ax.online.tableau.com/#/site/my-site,
# the pod URL is https://10ax.online.tableau.com
TABLEAU_SERVER_URL=https://<pod>.online.tableau.com

# The site's "content URL" -- the slug after /site/ in that same address bar
# URL, NOT the site's display name. For https://10ax.online.tableau.com/#/site/my-site/...
# this is "my-site".
TABLEAU_SITE_CONTENT_URL=

# Project (folder) to publish into. Must already exist on the site.
TABLEAU_PROJECT_NAME=Default

# Name to give the published data source.
TABLEAU_DATASOURCE_NAME=Finished Merged

# ---- Authentication (Personal Access Token) --------------------------------

# Create one at: Tableau Cloud -> your avatar -> Account Settings ->
# Personal Access Tokens -> Create new token. PATs work regardless of
# MFA/SSO, unlike username/password.
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_SECRET=
